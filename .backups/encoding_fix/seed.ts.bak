
import { config } from 'dotenv';
import { resolve } from 'path';
import { PrismaPg } from '@prisma/adapter-pg';
import { PrismaClient } from '../generated/prisma/client';
import { Pool } from 'pg';

config({ path: resolve(__dirname, '../../../../.env') });

const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
});

const adapter = new PrismaPg(pool);
const prisma = new PrismaClient({ adapter });

const roles = [
  {
    name: 'USER',
    description: 'à¦¸à¦¾à¦§à¦¾à¦°à¦£ à¦¨à¦¿à¦¬à¦¨à§à¦§à¦¿à¦¤ à¦¬à§à¦¯à¦¬à¦¹à¦¾à¦°à¦•à¦¾à¦°à§€ à¦“ à¦¶à¦¿à¦•à§à¦·à¦¾à¦°à§à¦¥à§€',
  },
  {
    name: 'MODERATOR',
    description: 'à¦•à¦¨à¦Ÿà§‡à¦¨à§à¦Ÿ à¦“ à¦ªà§à¦°à¦¶à§à¦¨ à¦ªà¦°à§à¦¯à¦¬à§‡à¦•à§à¦·à¦£à¦•à¦¾à¦°à§€',
  },
  {
    name: 'ADMIN',
    description: 'à¦ªà§à¦²à§à¦¯à¦¾à¦Ÿà¦«à¦°à§à¦® à¦ªà§à¦°à¦¶à¦¾à¦¸à¦•',
  },
  {
    name: 'SUPER_ADMIN',
    description: 'à¦ªà§à¦²à§à¦¯à¦¾à¦Ÿà¦«à¦°à§à¦®à§‡à¦° à¦¸à¦°à§à¦¬à§‹à¦šà§à¦š à¦ªà§à¦°à¦¶à¦¾à¦¸à¦¨à¦¿à¦• à¦¨à¦¿à§Ÿà¦¨à§à¦¤à§à¦°à¦£',
  },
];

const permissions = [
  { key: 'profile.read', description: 'à¦¨à¦¿à¦œà§‡à¦° à¦ªà§à¦°à§‹à¦«à¦¾à¦‡à¦² à¦¦à§‡à¦–à¦¾' },
  { key: 'profile.update', description: 'à¦¨à¦¿à¦œà§‡à¦° à¦ªà§à¦°à§‹à¦«à¦¾à¦‡à¦² à¦ªà¦°à¦¿à¦¬à¦°à§à¦¤à¦¨' },
  { key: 'questions.read', description: 'à¦ªà§à¦°à¦¶à§à¦¨ à¦¦à§‡à¦–à¦¾' },
  { key: 'exams.read', description: 'à¦ªà¦°à§€à¦•à§à¦·à¦¾ à¦¦à§‡à¦–à¦¾' },
  { key: 'exams.attempt', description: 'à¦ªà¦°à§€à¦•à§à¦·à¦¾à§Ÿ à¦…à¦‚à¦¶à¦—à§à¦°à¦¹à¦£' },
  { key: 'results.read', description: 'à¦¨à¦¿à¦œà§‡à¦° à¦«à¦²à¦¾à¦«à¦² à¦¦à§‡à¦–à¦¾' },
  { key: 'library.read', description: 'à¦¡à¦¿à¦œà¦¿à¦Ÿà¦¾à¦² à¦²à¦¾à¦‡à¦¬à§à¦°à§‡à¦°à¦¿ à¦¬à§à¦¯à¦¬à¦¹à¦¾à¦°' },
  { key: 'content.review', description: 'à¦•à¦¨à¦Ÿà§‡à¦¨à§à¦Ÿ à¦ªà¦°à§à¦¯à¦¾à¦²à§‹à¦šà¦¨à¦¾' },
  { key: 'questions.review', description: 'à¦ªà§à¦°à¦¶à§à¦¨ à¦ªà¦°à§à¦¯à¦¾à¦²à§‹à¦šà¦¨à¦¾' },
  { key: 'users.moderate', description: 'à¦¬à§à¦¯à¦¬à¦¹à¦¾à¦°à¦•à¦¾à¦°à§€ à¦ªà¦°à§à¦¯à¦¬à§‡à¦•à§à¦·à¦£' },
  { key: 'users.manage', description: 'à¦¬à§à¦¯à¦¬à¦¹à¦¾à¦°à¦•à¦¾à¦°à§€ à¦ªà¦°à¦¿à¦šà¦¾à¦²à¦¨à¦¾' },
  { key: 'content.manage', description: 'à¦•à¦¨à¦Ÿà§‡à¦¨à§à¦Ÿ à¦ªà¦°à¦¿à¦šà¦¾à¦²à¦¨à¦¾' },
  { key: 'rbac.manage', description: 'Role à¦“ Permission à¦ªà¦°à¦¿à¦šà¦¾à¦²à¦¨à¦¾' },
  { key: 'analytics.read', description: 'à¦ªà§à¦²à§à¦¯à¦¾à¦Ÿà¦«à¦°à§à¦® à¦°à¦¿à¦ªà§‹à¦°à§à¦Ÿ à¦¦à§‡à¦–à¦¾' },
  { key: 'audit.logs.read', description: 'à¦…à¦¡à¦¿à¦Ÿ à¦²à¦— à¦¦à§‡à¦–à¦¾' },
  { key: 'system.settings.manage', description: 'à¦¸à¦¿à¦¸à§à¦Ÿà§‡à¦® à¦¸à§‡à¦Ÿà¦¿à¦‚à¦¸ à¦ªà¦°à¦¿à¦šà¦¾à¦²à¦¨à¦¾' },

  // Subject and Topic management
  { key: 'subjects.manage', description: 'à¦¬à¦¿à¦·à§Ÿ à¦ªà¦°à¦¿à¦šà¦¾à¦²à¦¨à¦¾' },
  { key: 'topics.manage', description: 'à¦¬à¦¿à¦·à§Ÿà¦­à¦¿à¦¤à§à¦¤à¦¿à¦• à¦Ÿà¦ªà¦¿à¦• à¦ªà¦°à¦¿à¦šà¦¾à¦²à¦¨à¦¾' },
];

async function main() {
  console.log('Creating default roles...');

  const roleRecords = await Promise.all(
    roles.map((role) =>
      prisma.role.upsert({
        where: { name: role.name },
        update: { description: role.description },
        create: role,
      }),
    ),
  );

  console.log('Creating default permissions...');

  const permissionRecords = await Promise.all(
    permissions.map((permission) =>
      prisma.permission.upsert({
        where: { key: permission.key },
        update: { description: permission.description },
        create: permission,
      }),
    ),
  );

  const roleIds = Object.fromEntries(
    roleRecords.map((role) => [role.name, role.id]),
  );

  const permissionIds = Object.fromEntries(
    permissionRecords.map((permission) => [permission.key, permission.id]),
  );

  const userPermissions = [
    'profile.read',
    'profile.update',
    'questions.read',
    'exams.read',
    'exams.attempt',
    'results.read',
    'library.read',
  ];

  const moderatorPermissions = [
    ...userPermissions,
    'content.review',
    'questions.review',
    'users.moderate',
  ];

  const adminPermissions = permissions
    .map((permission) => permission.key)
    .filter(
      (key) =>
        key !== 'system.settings.manage' &&
        key !== 'rbac.manage',
    );

  const superAdminPermissions = permissions.map(
    (permission) => permission.key,
  );

  const assignments: Array<{
    roleId: string;
    permissionId: string;
  }> = [];

  const rolePermissionMap: Record<string, string[]> = {
    USER: userPermissions,
    MODERATOR: moderatorPermissions,
    ADMIN: adminPermissions,
    SUPER_ADMIN: superAdminPermissions,
  };

  for (const [roleName, permissionKeys] of Object.entries(rolePermissionMap)) {
    const roleId = roleIds[roleName];

    if (!roleId) {
      throw new Error(`Role ID à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿: ${roleName}`);
    }

    for (const permissionKey of permissionKeys) {
      const permissionId = permissionIds[permissionKey];

      if (!permissionId) {
        throw new Error(`Permission ID à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿: ${permissionKey}`);
      }

      assignments.push({ roleId, permissionId });
    }
  }

  await prisma.rolePermission.createMany({
    data: assignments,
    skipDuplicates: true,
  });
  // Remove any previously assigned RBAC management permission from ADMIN.
  const adminRoleId = roleIds['ADMIN'];
  const rbacManagePermissionId = permissionIds['rbac.manage'];

  if (adminRoleId && rbacManagePermissionId) {
    await prisma.rolePermission.deleteMany({
      where: {
        roleId: adminRoleId,
        permissionId: rbacManagePermissionId,
      },
    });
  }

  console.log('\n========== SEED SUMMARY ==========');
  console.log(`Roles: ${roleRecords.length}`);
  console.log(`Permissions: ${permissionRecords.length}`);
  console.log(`Role-Permission links processed: ${assignments.length}`);
  console.log('Subject management: ADMIN, SUPER_ADMIN');
  console.log('Topic management: ADMIN, SUPER_ADMIN');
  console.log('Subject and Topic read APIs: PUBLIC');
  console.log('SUPER_ADMIN assigned to users: NO');
  console.log('ADMIN assigned to users: NO');
  console.log('\nDefault roles and permissions seeded successfully.');
}

main()
  .catch((error) => {
    console.error('Seed failed:', error);
    process.exitCode = 1;
  })
  .finally(async () => {
    await prisma.$disconnect();
    await pool.end();
  });
