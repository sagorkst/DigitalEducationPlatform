{
  "name": "@shikhasetu/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:rbac": "node --test tests/rbac.service.test.cjs",
    "db:seed": "ts-node src/database/seed.ts",
    "db:bootstrap-super-admin": "ts-node src/database/bootstrap-super-admin.ts",
    "test:auth": "node --test tests/auth.service.test.cjs",
    "test:users": "node --test tests/users.service.test.cjs",
    "test:public-questions": "npm run build && node --test tests/public-questions.service.test.cjs",
    "test:questions-security": "node --test test/questions-security.integration.test.cjs",
    "test:html-import": "npm run build && node --test tests/html-question-parser.service.test.cjs tests/import-image-standardization.service.test.cjs tests/imports.controller.test.cjs",
    "prebuild": "prisma generate --config ../../prisma7.config.ts",
    "pretypecheck": "prisma generate --config ../../prisma7.config.ts",
    "prestart:dev": "prisma generate --config ../../prisma7.config.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "helmet": "^8.3.0",
    "mailparser": "^3.14.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
